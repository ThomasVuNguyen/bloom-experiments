# BloomOne Next.js Chat Frontend
# Copy this to .env.local for local development

# ── Database (Coolify PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@postgresql-UUID:5432/bloomone

# Modal backend URL (the chatbot ASGI endpoint)
BLOOMONE_API_URL=https://YOUR_WORKSPACE--bloomone-chatbot.modal.run

# API key for authenticating with the backend (from Modal secret)
BLOOMONE_API_KEY=your-api-key-here

# ── Local File Storage ───────────────────────────────────────────────────────
# File blobs are still stored on disk (metadata in PostgreSQL)
UPLOADS_DIR=/app/data/uploads
